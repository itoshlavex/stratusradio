# Cloudflare response headers for Stratus Radio.
# Station logo addresses carry a version (?v=N, see LOGO_VERSION in app.js),
# so they can be kept for a year; a replaced logo gets a new address.
/logos/*
  Cache-Control: public, max-age=31536000, immutable

# The Android app is replaced at the same address each release, so never keep an
# old copy, and hand it straight to Android's installer.
/download/*
  Cache-Control: no-store
  Content-Type: application/vnd.android.package-archive

# Lets Chrome open the Android app full screen (see android/).
/.well-known/assetlinks.json
  Content-Type: application/json
