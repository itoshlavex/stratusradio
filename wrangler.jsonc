// Cloudflare settings for Stratus Radio.
// Cloudflare reads this file every time it deploys a push from GitHub.
// The app is plain files, so there is no build step: the files at the top
// level of the repo are served as they are (except those in .assetsignore).
// worker.js sees every request: it sends the old address to stratusradio.app,
// answers /api/now (the "now playing" lookup), and hands the rest to the files.
{
  "name": "stratusradio",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Every address goes through worker.js first, so the old one is redirected
    // whatever page was asked for, not just /api/. The files themselves are
    // still served by Cloudflare; the Worker only passes them through.
    "run_worker_first": true,
    // Addresses that aren't a file (like /yumi-fm, a shared station link)
    // open the app, which then picks that station.
    "not_found_handling": "single-page-application"
  },
  // stratusradio.app is the app's address. The other two are attached for one
  // reason each: worker.js answers anything that is not stratusradio.app with a
  // permanent redirect to it, so the www. address works for anyone who types it,
  // and old links to stratusradio.ololiohill.io still open their station.
  // Nothing is served on either. Take one out of this list and it detaches,
  // stops redirecting, and simply fails instead.
  "routes": [
    { "pattern": "stratusradio.app", "custom_domain": true },
    { "pattern": "www.stratusradio.app", "custom_domain": true },
    { "pattern": "stratusradio.ololiohill.io", "custom_domain": true }
  ],
  // No *.workers.dev address, and no per-branch preview links on it either:
  // stratusradio.app is the only address the app answers on.
  "workers_dev": false,
  "preview_urls": false,
  // Keep request logs in the Cloudflare dashboard (Worker → Observability).
  "observability": {
    "enabled": true
  }
}
